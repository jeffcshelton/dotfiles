#!/bin/sh
# JankyBorders, styled after Hyprland's window borders on Jupiter.
#
# When started without arguments, borders runs this file, which then passes the
# options below to the running instance.

borders \
  style=round \
  width=4.0 \
  hidpi=on \
  active_color="gradient(top_left=0xee33ccff,bottom_right=0xee00ff99)" \
  inactive_color=0xaa595959
