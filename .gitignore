.DS_Store

# Ignore hypr-rdp's auto-generated TLS certificate and private key.
.config/hypr-rdp/*.pem
.config/hypr-rdp/.*.pem.tmp
.config/hypr-rdp/.tls.lock

# Ignore Karabiner generated backups.
.config/karabiner/automatic_backups/

# Ignore Tmux plugins except for TPM.
.config/tmux/plugins/
!.config/tmux/plugins/tpm/

# Ignore the dynamically constructed Waybar config.
.config/waybar/config.jsonc

# Ignore locally symlinked files built with `nix build`.
images/
result
/nix/secrets/.decrypted
